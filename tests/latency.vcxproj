<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\Clicklet.vcxproj" />
  <Import Project="..\diagnostics\common.props" />
  <ItemGroup>
    <ClCompile Remove="@(ClCompile)" />
    <ResourceCompile Remove="@(ResourceCompile)" />
    <ClCompile Include="latency.cpp" />
  </ItemGroup>
  <Target Name="CopyLatencyFixtures" AfterTargets="Build">
    <ItemGroup><LatencyFixture Include="$(MSBuildThisFileDirectory)fixtures\*.ini" /></ItemGroup>
    <Copy SourceFiles="@(LatencyFixture)" DestinationFolder="$(OutDir)fixtures" />
  </Target>
</Project>
